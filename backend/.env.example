# ===== 起動前に必要な設定 =====
# DB を読む前に必要なもの・DB に置けないものだけがここに残る。
# 外部サービスの API キーは管理画面（管理 → 設定 → 外部サービス連携）から設定できる。

# Database（DB 自身の接続先なので DB には置けない）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/setori?sslmode=disable

# 管理画面から保存する API キーを DB 上で暗号化するための鍵。
# バックアップ（pg_dump）は Google Drive へ自動アップロードされるため、鍵を DB に置くと
# 一緒に流出して意味が無い。ここだけは環境変数で持つ。
# 未設定でも起動はするが、管理画面からの機密の保存はできない（下のフォールバックは使える）。
# 任意の長い文字列でよい（内部で SHA-256 により 32 バイトへ伸長する）。
#   例: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# 初期管理者アカウント：ユーザーが 0 件のとき初回起動時に作成される。
# （UI がまだ使えない時点で必要なのでここに残る）
# 作成後は管理画面（管理 → ユーザー）からパスワードを変更してください。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# OAuth のリダイレクト先。デプロイ先の URL に合わせる。
# 間違えるとログインできなくなるため UI からは変更できないようにしている。
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# 訪客／利用者のアクセス記録（IP・pathname・User-Agent）を保持する日数。
# 1〜365 日。管理 → アクセス は users:manage 権限だけが閲覧できる。
ACTIVITY_RETENTION_DAYS=30

# CF-Connecting-IP / X-Forwarded-For を信用してよい直前 proxy の CIDR。
# ローカルで backend に直接接続するだけなら既定値のままでよい。
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Server（listen 開始前に必要）
HOST=0.0.0.0
PORT=8080

# バックアップの保存先（ファイルシステムの設定）
BACKUP_DIR=./backups
# ホストに pg_dump が無い場合に使う PostgreSQL コンテナ名
BACKUP_PG_CONTAINER=setori-postgres


# ===== 以下は管理画面から設定できる（ここは未設定時のフォールバック） =====
# 管理 → 設定 → 外部サービス連携 で登録するとそちらが優先されます。
# 新規に設定するなら管理画面を推奨（DB 上で暗号化され、再起動も不要）。

HOLODEX_API_KEY=
HOLODEX_EDITOR_TOKEN=
YOUTUBE_API_KEY=

# GROQ_API_KEY は「管理画面で AI プロバイダーが一つも設定されていない場合」の予備キーです。
# 建議改用管理介面（設定頁 → AIプロバイダー管理）登記多個 OpenAI 相容 provider 輪流使用。
GROQ_API_KEY=

# Google Drive バックアップ用（「TV と限定入力デバイス」型の OAuth クライアント）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google ログイン用（「ウェブアプリケーション」型の OAuth クライアント）
# 上の Drive 用とは型が違うため流用できません。
# 承認済みリダイレクト URI: {OAUTH_REDIRECT_BASE_URL}/api/auth/oauth/google/callback
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
