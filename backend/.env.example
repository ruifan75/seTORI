# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/setori?sslmode=disable

# API Keys
HOLODEX_API_KEY=your-holodex-api-key
HOLODEX_EDITOR_TOKEN=your-holodex-editor-token
# GROQ_API_KEY 為「未在管理介面設定任何 AI provider 時」的後備 key。
# 建議改用管理介面（設定頁 → AIプロバイダー管理）登記多個 OpenAI 相容 provider 輪流使用。
GROQ_API_KEY=your-groq-api-key
YOUTUBE_API_KEY=your_api_key_here

# JWT (reserved, not yet used)
JWT_SECRET=your-jwt-secret-change-in-production

# API auth — 若設定，寫入操作（POST/PUT/DELETE）需帶 Authorization: Bearer <token>
# 留空則寫入 API 為公開（僅適合本機開發）
API_AUTH_TOKEN=

# Environment
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8080
