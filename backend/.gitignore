# Environment variables
# .env.bk / .env.old のような手元の控えも確実に除外されるよう、
# .env で始まるものは .env.example を除いて全部無視する
.env*
!.env.example

# Build output
bin/
server
*.exe
*.dll
*.so
*.dylib

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml

# Go
*.o
*.a
*.so
vendor/

# Logs
logs/
*.log

# Downloaded live chat cache
data/

# DB backups (pg_dump)
backups/
