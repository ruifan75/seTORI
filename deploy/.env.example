# 本番用。cp .env.example .env して埋める。
# このファイル自体は git に入れてよいが、.env は絶対にコミットしないこと。

# ===== 必須 =====

# 証明書を取るドメイン。DNS の A レコードがこのサーバーを指していること。
DOMAIN=setori.example.com

# Postgres のパスワード。開発用の postgres/postgres は使わない。
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# 管理画面から保存する API キーを DB 上で暗号化する鍵。
#   openssl rand -base64 32
#
# ⚠️ 開発環境とは別の新しい鍵にすること。
# ⚠️ この鍵をバックアップ（pg_dump）と同じ場所に置かないこと。バックアップは
#    Google Drive へ自動アップロードされるため、鍵が一緒だと暗号化の意味が無くなる。
# ⚠️ 失うと DB に保存済みの API キーが復号できなくなる。手元にも控えておくこと。
SETTINGS_ENCRYPTION_KEY=

# 初期管理者。ユーザーが 0 件のとき（＝新しい DB の初回起動時）だけ作られる。
# ⚠️ admin/admin のままで公開しないこと。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 公開 URL。OAuth のリダイレクト先になるので https と実ドメインで揃える。
# ここを間違えると Google ログインが失敗する。
OAUTH_REDIRECT_BASE_URL=https://setori.example.com
FRONTEND_BASE_URL=https://setori.example.com

# ===== 任意 =====

ENVIRONMENT=production
LOG_LEVEL=INFO

POSTGRES_USER=postgres
POSTGRES_DB=setori

# 外部サービスの API キーは管理画面（管理 → 設定 → 外部サービス連携）から
# 登録する。DB 上で暗号化され、再起動も不要。ここには書かなくてよい。
#
# YouTube の cookie（live chat の取得に使う）も同じ画面から貼れる。
# ファイルで渡したい場合だけ、compose に cookies.txt をマウントしてここを指す：
#   YTDLP_COOKIES_FILE=/app/cookies.txt
# 起動時に一度だけ読むので、差し替えたら再起動が要る（画面から入れれば即時反映）。
