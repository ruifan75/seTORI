
# 本番の秘密情報。.env.example だけを追跡する
/deploy/.env
/deploy/.env.*
!/deploy/.env.example

# YouTube のログイン cookie（yt-dlp が BOT 判定を回避するのに使う）。
# セッションそのものなので絶対に追跡しない。運用では管理→設定から登録する
cookies.txt
*cookies.txt

# Reference clones (own .git — not part of this repo)
/Holodex/
/backend/Holodex/
/Musicdex/
/utawaku-timestamp/

# Scratch screenshots dropped at repo root (not part of this repo)
/*.png
/*.jpg
/*.jpeg

# macOS / エディタが撒くファイル
.DS_Store
Thumbs.db
*.swp

# Claude Code のローカル作業ファイル
/.claude/

# Cloudflare Origin CA の証明書と秘密鍵（本番機に手で置く。git には絶対に入れない）
deploy/certs/
*.key
*.pem
