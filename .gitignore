
# 本番の秘密情報。.env.example だけを追跡する
/deploy/.env
/deploy/.env.*
!/deploy/.env.example

# YouTube のログイン cookie（yt-dlp が BOT 判定を回避するのに使う）。
# セッションそのものなので絶対に追跡しない。運用では管理→設定から登録する
cookies.txt
*cookies.txt

# Reference clones (own .git — not part of this repo)
/Holodex/
/backend/Holodex/
/Musicdex/
/utawaku-timestamp/

# Scratch screenshots dropped at repo root (not part of this repo)
/*.png
/*.jpg
/*.jpeg

# macOS / エディタが撒くファイル
.DS_Store
Thumbs.db
*.swp

# Claude Code のローカル作業ファイル
/.claude/

# Cloudflare Origin CA の証明書と秘密鍵（本番機に手で置く。git には絶対に入れない）
deploy/certs/
*.key
*.pem

# 本番データから生成した分析結果（再生成できるので追跡しない）
# 解析で作った CSV・DB ダンプ・ログは追跡しない。
# 2026-08-13 に `git add -A` で DB ダンプ（users / sessions / ai_providers を含む）を
# 誤って commit した。個別に列挙するのではなく、拡張子ごと弾く。
*.csv
*.dump
*.sql.gz
*.log
